# Generated by devctl from templates/engines/qdrant/compose.yaml.tmpl. Do not edit.
name: {{NAME}}
services:
  db:
    image: "{{IMAGE}}"
    container_name: "{{NAME}}"
    restart: "on-failure:3"
    env_file: ["{{SECRETS}}"]
    ports: ["127.0.0.1:{{PORT}}:6333"]
    volumes: ["{{DATA}}:/qdrant/storage:Z"]
    labels: {devctl.managed: "true", devctl.server: "{{ID}}", devctl.engine: "qdrant"}
    healthcheck:
      test: ["CMD", "bash", "-c", ":> /dev/tcp/127.0.0.1/6333"]
      interval: 3s
      timeout: 5s
      retries: 60
    logging: {driver: json-file, options: {max-size: "10m", max-file: "3"}}
    networks: [devctl]
networks:
  devctl: {external: true}
