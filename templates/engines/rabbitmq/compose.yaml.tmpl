# Generated by devctl from templates/engines/rabbitmq/compose.yaml.tmpl. Do not edit.
name: {{NAME}}
services:
  svc:
    image: "{{IMAGE}}"
    container_name: "{{NAME}}"
    hostname: "{{NAME}}"
    restart: "on-failure:3"
    env_file: ["{{SECRETS}}"]
    ports: ["127.0.0.1:{{PORT}}:5672", "127.0.0.1:{{PORT_UI}}:15672"]
    volumes: ["{{DATA}}:/var/lib/rabbitmq:Z"]
    labels: {devctl.managed: "true", devctl.server: "{{ID}}", devctl.engine: "rabbitmq"}
    healthcheck: {test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"], interval: 5s, timeout: 10s, retries: 60}
    logging: {driver: json-file, options: {max-size: "10m", max-file: "3"}}
    networks: [devctl]
networks:
  devctl: {external: true}
