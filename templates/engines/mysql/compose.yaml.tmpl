# Generated by devctl from templates/engines/mysql/compose.yaml.tmpl. Do not edit.
name: {{NAME}}
services:
  db:
    image: "{{IMAGE}}"
    container_name: "{{NAME}}"
    restart: "on-failure:3"
    env_file: ["{{SECRETS}}"]
    ports: ["127.0.0.1:{{PORT}}:3306"]
    volumes: ["{{DATA}}:/var/lib/mysql:Z"]
    labels: {devctl.managed: "true", devctl.server: "{{ID}}", devctl.engine: "mysql"}
    healthcheck:
      test: ["CMD-SHELL", "MYSQL_PWD=\"$$MYSQL_ROOT_PASSWORD\" mysqladmin ping -h 127.0.0.1 -uroot --silent"]
      interval: 3s
      timeout: 5s
      retries: 60
    logging: {driver: json-file, options: {max-size: "10m", max-file: "3"}}
    networks: [devctl]
networks:
  devctl: {external: true}
