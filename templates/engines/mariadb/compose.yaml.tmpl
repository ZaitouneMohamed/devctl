# Generated by devctl from templates/engines/mariadb/compose.yaml.tmpl. Do not edit.
name: {{NAME}}
services:
  db:
    image: "{{IMAGE}}"
    container_name: "{{NAME}}"
    restart: "on-failure:3"
    env_file: ["{{SECRETS}}"]
    ports: ["127.0.0.1:{{PORT}}:3306"]
    volumes: ["{{DATA}}:/var/lib/mariadb:Z"]
    labels: {devctl.managed: "true", devctl.server: "{{ID}}", devctl.engine: "mariadb"}
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 3s
      timeout: 5s
      retries: 60
    logging: {driver: json-file, options: {max-size: "10m", max-file: "3"}}
    networks: [devctl]
networks:
  devctl: {external: true}
