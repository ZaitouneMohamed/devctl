# Generated by devctl from templates/engines/postgres/compose.yaml.tmpl. Do not edit.
# The image declares /var/lib/postgresql as a volume and keeps data in <major>/docker under
# it: mount that folder (no stray anonymous volumes). The server's data folder is 0711 so
# the "postgres" user can pass through it; data/ itself stays 0700.
name: {{NAME}}
services:
  db:
    image: "{{IMAGE}}"
    container_name: "{{NAME}}"
    restart: "on-failure:3"
    env_file: ["{{SECRETS}}"]
    ports: ["127.0.0.1:{{PORT}}:5432"]
    volumes: ["{{DATA}}:/var/lib/postgresql:Z"]
    labels: {devctl.managed: "true", devctl.server: "{{ID}}", devctl.engine: "postgres"}
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres", "-h", "127.0.0.1"]
      interval: 3s
      timeout: 5s
      retries: 60
    logging: {driver: json-file, options: {max-size: "10m", max-file: "3"}}
    networks: [devctl]
networks:
  devctl: {external: true}
