# Generated by devctl from templates/engines/rustfs/compose.yaml.tmpl. Do not edit.
# The image runs as UID 10001 by default; devctl runs it as your UID so it can write its data folder.
name: {{NAME}}
services:
  svc:
    image: "{{IMAGE}}"
    container_name: "{{NAME}}"
    restart: "on-failure:3"
    user: "{{UID}}:{{GID}}"
    env_file: ["{{SECRETS}}"]
    environment: {RUSTFS_CONSOLE_ENABLE: "true"}
    ports: ["127.0.0.1:{{PORT}}:9000", "127.0.0.1:{{PORT_CONSOLE}}:9001"]
    volumes: ["{{DATA}}:/data:Z"]
    labels: {devctl.managed: "true", devctl.server: "{{ID}}", devctl.engine: "rustfs"}
    logging: {driver: json-file, options: {max-size: "10m", max-file: "3"}}
    networks: [devctl]
networks:
  devctl: {external: true}
