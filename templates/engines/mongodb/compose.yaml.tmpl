# Generated by devctl from templates/engines/mongodb/compose.yaml.tmpl. Do not edit.
name: {{NAME}}
services:
  db:
    image: "{{IMAGE}}"
    container_name: "{{NAME}}"
    restart: "on-failure:3"
    env_file: ["{{SECRETS}}"]
    ports: ["127.0.0.1:{{PORT}}:27017"]
    volumes: ["{{DATA}}:/data/db:Z"]
    labels: {devctl.managed: "true", devctl.server: "{{ID}}", devctl.engine: "mongodb"}
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand({ping: 1}).ok"]
      interval: 3s
      timeout: 5s
      retries: 60
    logging: {driver: json-file, options: {max-size: "10m", max-file: "3"}}
    networks: [devctl]
networks:
  devctl: {external: true}
